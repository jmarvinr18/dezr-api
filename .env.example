# Used by docker-compose.yml. Copy to .env and fill in.
POSTGRES_USER=dezr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dezr

# Host ports (container ports are 5432 and 8000).
POSTGRES_HOST_PORT=5435
API_HOST_PORT=8001

# The admin created on first start (when there is no admin yet). Leave the password empty and a
# strong one is generated and printed once: docker compose logs api | grep -A1 "default admin".
# Set DEFAULT_ADMIN_EMAIL= (empty) to skip.
DEFAULT_ADMIN_EMAIL=admin@deszr.com
DEFAULT_ADMIN_PASSWORD=

# Signs admin access tokens. 32+ random characters, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Browser origins allowed to call the API directly (the Nuxt dev server).
CORS_ORIGINS=http://localhost:3000

# Proxies in front of the API that set X-Forwarded-For. 1 when only the Nuxt server calls the
# API and forwards the visitor's IP; 0 when browsers call it directly.
TRUSTED_PROXY_COUNT=0

# Where the website serves uploaded files (media URLs in responses are <base>/<name>).
MEDIA_PUBLIC_BASE_URL=/media

# ---- Documents for the AI assistant (RAG ingestion) ----
# Vectors for the passages, switchable at any time (restart; the worker re-embeds the existing
# documents with the new model on start):
# - "openai": OpenAI's API with OPENAI_API_KEY (text-embedding-3-small by default);
# - "bedrock": Amazon Bedrock (the AWS identity below needs bedrock:InvokeModel on the model);
# - "none": keyword search only.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
# Empty: the provider's default (openai: text-embedding-3-small; bedrock:
# cohere.embed-multilingual-v3). Also: text-embedding-3-large, or amazon.titan-embed-text-v2:0
# (not offered in ap-southeast-1; use another EMBEDDING_REGION). All at 1024 dimensions.
EMBEDDING_MODEL_ID=
# Bedrock only: a region that offers the model.
EMBEDDING_REGION=ap-southeast-1
# Where documents become searchable: "pgvector" (this database) or "bedrock_kb" (an existing
# Bedrock Knowledge Base; files are copied to its S3 data source, KNOWLEDGE_BASE_S3_URI).
RETRIEVAL_BACKEND=pgvector
KNOWLEDGE_BASE_ID=
KNOWLEDGE_BASE_DATA_SOURCE_ID=
KNOWLEDGE_BASE_S3_URI=
KNOWLEDGE_BASE_REGION=ap-southeast-1
# Empty for the knowledge base's default; HYBRID or SEMANTIC where its vector store supports it.
KNOWLEDGE_BASE_SEARCH_TYPE=
# Hybrid chunking limits, in approximate tokens.
CHUNK_MAX_TOKENS=400
CHUNK_MIN_TOKENS=60
CHUNK_OVERLAP_TOKENS=50
# Bearer key the AI assistant (dezr-ai) uses for POST /api/v1/documents/search. Empty turns the
# endpoint off. 32+ random characters: python -c "import secrets; print(secrets.token_hex(32))"
DOCUMENT_SEARCH_API_KEY=

# ---- AI assistant: the chat relays to the dezr-ai agent ----
# The AgentCore runtime (dezr-ai: terraform output agent_runtime_arn); the AWS identity needs
# bedrock-agentcore:InvokeAgentRuntime on it. Or AI_AGENT_URL for dezr-ai on this machine.
AI_AGENT_RUNTIME_ARN=
AI_AGENT_REGION=ap-southeast-1
# AI_AGENT_URL=http://host.docker.internal:8080/invocations
# Bearer key dezr-ui's server sends (NUXT_CHAT_API_TOKEN). Empty leaves the chat open.
AI_API_KEY=
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_MESSAGE_LIMIT=1000

# ---- Media and document storage ----
# "s3" (default) or "local" (container disk, development only).
STORAGE_BACKEND=s3
S3_BUCKET=dezr-media
S3_REGION=ap-southeast-1
# Object keys become <prefix>/media/<random>.<ext>
S3_KEY_PREFIX=dezr
# AES256 (S3-managed keys), aws:kms (set S3_KMS_KEY_ID too), or empty for the bucket default.
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=

# AWS credentials for an IAM user limited to this bucket (s3:PutObject, s3:GetObject,
# s3:DeleteObject on arn:aws:s3:::<bucket>/<prefix>/*). Leave empty on ECS/EC2 to use the role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Local S3 emulator instead of AWS: docker compose --profile local-s3 up -d ----
# S3_ENDPOINT_URL=http://s3:5000
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
