# Local development without Docker. Copy to app/.env (git-ignored).
# PostgreSQL with the pgvector extension (e.g. the pgvector/pgvector:pg17 Docker image).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dezr

# Signs admin access tokens. Optional in debug mode (a random key is made per run, so
# sign-ins end on restart); required in production.
# SECRET_KEY=

# The admin `uv run flask admin ensure-default` creates when there is no admin yet. Without a
# password a strong one is generated and printed once.
# DEFAULT_ADMIN_EMAIL=admin@deszr.com
# DEFAULT_ADMIN_PASSWORD=

# Store uploads on disk under ./uploads instead of S3.
STORAGE_BACKEND=local
# UPLOAD_FOLDER=

# Documents for the AI assistant: processed in a background thread of `flask run`.
# Without an embeddings key, store passages without vectors (keyword search only):
EMBEDDING_PROVIDER=none
# With OpenAI (text-embedding-3-small unless EMBEDDING_MODEL_ID says otherwise):
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# With Bedrock instead:
# EMBEDDING_PROVIDER=bedrock
# EMBEDDING_MODEL_ID=cohere.embed-multilingual-v3
# EMBEDDING_REGION=ap-southeast-1
# After switching: uv run flask documents reprocess --stale
# Or search a Bedrock Knowledge Base (see ../.env.example):
# RETRIEVAL_BACKEND=bedrock_kb
# KNOWLEDGE_BASE_ID=
# KNOWLEDGE_BASE_DATA_SOURCE_ID=
# KNOWLEDGE_BASE_S3_URI=s3://bucket/prefix/

# The AI assistant: dezr-ai running locally (`uv run python main.py` in dezr-ai), or its
# AgentCore runtime (needs AWS credentials allowed to invoke it).
# AI_AGENT_URL=http://localhost:8080/invocations
# AI_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:ap-southeast-1:<account>:runtime/<id>

# Comma-separated origins allowed to call the API (the Nuxt dev server).
CORS_ORIGINS=http://localhost:3000
