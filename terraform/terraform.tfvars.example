# Copy to terraform.tfvars (git-ignored) and adjust. Every setting has a default; see variables.tf.

aws_region = "ap-southeast-1"

# Cheapest that comfortably runs the API, the document worker and PostgreSQL (Graviton, 2 GiB).
instance_type = "t4g.small"

# The default admin, created on first boot (admin@deszr.com unless set). Its password is generated
# unless you choose one; read it with `terraform output -raw admin_password`.
# admin_email    = "you@example.com"
# admin_password = "choose-12-or-more-characters"

# Who can reach the API on port 80. Narrow this to the dezr-ui server and your own IP when you can,
# then set trusted_proxy_count = 1.
# allowed_cidrs       = ["203.0.113.10/32"]
# trusted_proxy_count = 1

# Browser origins allowed to call the API directly (not needed when only dezr-ui's server calls it).
# cors_origins = ["https://www.deszr.com"]

# Document vectors: Amazon Bedrock by default; "none" for keyword search only.
# embedding_provider = "none"
# embedding_region   = "us-east-1"

# SSH as well as Session Manager.
# ssh_key_name = "my-key"
# ssh_cidrs    = ["203.0.113.10/32"]

# The AI assistant: dezr-ai's AgentCore runtime (dezr-ai: terraform output agent_runtime_id).
# agent_runtime_id         = "dezr_ai_agent-oWJlg6Fpai"
# ai_rate_limit_per_minute = 10
# ai_daily_message_limit   = 1000
# ai_smoke_test            = true
